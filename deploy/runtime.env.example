DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&channel_binding=require
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
E2B_API_KEY=
E2B_TEMPLATE_ID=
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=600
RUN_MAX_TURNS=16
RUN_MAX_TOOL_CALLS=32
RUN_MAX_TOKENS=100000
SECRET_KEY=
ALLOWED_ORIGINS=https://webbuilder.abhayymishraa.us

# Authentication: set these to the deployed frontend/backend origins.
FRONTEND_URL=https://webbuilder.abhayymishraa.us
PUBLIC_API_URL=https://webbuilder-api.abhayymishraa.us
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=

# Private production bucket; scoped service-account JSON is mounted read-only.
STORAGE_PROVIDER=gcs
STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs.json
STORAGE_DAILY_UPLOAD_MB=256
STORAGE_DAILY_DOWNLOAD_MB=1024
