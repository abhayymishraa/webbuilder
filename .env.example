# Local PostgreSQL. Keep DATABASE_URL in sync with these values.
POSTGRES_USER=webbuilder
POSTGRES_PASSWORD=webbuilder-local
POSTGRES_DB=webbuilder
DATABASE_URL=postgresql://webbuilder:webbuilder-local@localhost:5432/webbuilder
# Backend credentials. Keep actual values in the ignored .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
E2B_API_KEY=
# Must include the browser tools from sandbox/Dockerfile.
E2B_TEMPLATE_ID=xjklh0xbjh3wpgu0w306
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_SECONDS=600
RUN_MAX_TURNS=16
RUN_MAX_TOOL_CALLS=32
RUN_MAX_TOKENS=100000
